# 复制为 backend/.env 后填写；也可留空，改在应用「模型配置」页里填。
# 数据库/Redis compose 已给默认值，本地直接跑可不改。
DATABASE_URL=postgresql://ragent:ragent@postgres:5432/ragent
REDIS_URL=redis://redis:6379/0

# LLM 接入：任意 OpenAI 兼容服务（自定义地址 / DeepSeek 等），全部留空则由配置页填写。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 单次模型请求的超时（秒）。服务商繁忙时会持续发空行保活，读超时必须放宽到覆盖排队时间。
LLM_REQUEST_TIMEOUT=180

# 推理强度：low / high / max，留空表示不传该字段、由服务端定档。
# 推理模型服务端默认多为 high，简单问答也要几十秒；默认给 low，复杂任务可在配置页调高。
LLM_REASONING_EFFORT=low

# 单身份每分钟提问上限（进程内滑动窗口；多副本部署需换成 Redis 计数）。
RATE_LIMIT_PER_MINUTE=10

# 成本估算单价（元 / 1K tokens）。这里只是新身份的种子默认值；
# 日常在「模型配置」页按身份修改，无需改 .env 或重启。0 表示不估算。
COST_INPUT_PER_1K=0
COST_OUTPUT_PER_1K=0
